rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['place', 'stars', 'name', 'text', 'photos', 'at'])
        && request.resource.data.place is string && request.resource.data.place.size() <= 40
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 3;
      allow update, delete: if false;
    }
    match /packs/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id', 'city', 'title', 'sub', 'who', 'tags', 'days', 'at', 'by'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.days is list && request.resource.data.days.size() <= 7;
      allow update, delete: if false;
    }
    match /feedback/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id', 'kind', 'parent', 'name', 'stars', 'text', 'at'])
        && request.resource.data.kind in ['post', 'reply']
        && request.resource.data.id is string && request.resource.data.id.size() <= 40
        && request.resource.data.parent is string && request.resource.data.parent.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() >= 2 && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }
    match /survey/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['use', 'age', 'from', 'at'])
        && request.resource.data.use in ['yes', 'no']
        && request.resource.data.age in ['', '10대', '20대', '30대', '40대', '50대', '60대', '70대']
        && request.resource.data.from in ['review', 'feedback', 'browse']
        && request.resource.data.at is int;
      allow update, delete: if false;
    }
  }
}
